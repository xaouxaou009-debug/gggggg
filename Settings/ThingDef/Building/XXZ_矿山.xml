			[1,1,1,1],
			[1,1,1,1],
		</Data>	
		<Offset>
			<y>0</y>
			<x>1.5</x>
		</Offset>	
		</Collider>
		<Harvest>
			<DropItems>
			</DropItems>  
		</Harvest>
		<Building>
			<MaxCount>1</MaxCount>
			<BePackage>0</BePackage>
			<IsVirtualBuilding>0</IsVirtualBuilding>
			<DontRemoveVirtual>1</DontRemoveVirtual>
			<CanMakeRoom>0</CanMakeRoom>
